[
  {
    "category": "basic_setting",
    "title": "基础设置",
    "settings": [
      {
        "key": "output_directory",
        "title": "输出目录",
        "type": "path",
        "description": "处理后的图片将保存在此目录下，请确保有足够的存储空间",
        "value": "/Users/sifan/Documents/images"
      },
      {
        "key": "output_format",
        "title": "输出格式",
        "type": "select",
        "options": ["png", "jpg", "webp"],
        "value": "png",
        "description": "PNG 支持透明背景，JPG 文件较小，WebP 兼具两者优势"
      },
      {
        "key": "preserve_directory_structure",
        "title": "保留文件夹结构",
        "type": "boolean",
        "value": false,
        "description": "保持原始文件夹结构，关闭可提升处理速度但无法预览"
      }
    ]
  },
  {
    "category": "model_setting",
    "title": "模型设置",
    "settings": [
      {
        "key": "alpha_matting",
        "title": "Alpha 抠图",
        "type": "boolean",
        "value": false,
        "description": "启用可获得更精细边缘，但会降低处理速度"
      },
      {
        "key": "alpha_matting_foreground_threshold",
        "title": "前景阈值",
        "type": "number",
        "min": 0,
        "max": 255,
        "value": 20,
        "description": "值越大保留的前景区域越少（推荐 220-250）"
      },
      {
        "key": "alpha_matting_background_threshold",
        "title": "背景阈值",
        "type": "number",
        "min": 0,
        "max": 255,
        "value": 15,
        "description": "值越小保留的背景区域越少（推荐 10-30）"
      },
      {
        "key": "alpha_matting_erode_size",
        "title": "边缘侵蚀大小",
        "type": "number",
        "min": 0,
        "max": 100,
        "value": 10,
        "description": "值越大边缘过渡越自然（推荐 30-50）"
      },
      {
        "key": "edge_refinement",
        "title": "边缘优化",
        "type": "boolean",
        "value": true,
        "description": "减少边缘黑边和杂点"
      },
      {
        "key": "edge_feather",
        "title": "边缘羽化",
        "type": "number",
        "min": 0,
        "max": 10,
        "value": 1,
        "description": "值越大边缘过渡越柔和（推荐 3-8）"
      },
      {
        "key": "edge_padding",
        "title": "边缘扩展",
        "type": "number",
        "min": 0,
        "max": 50,
        "value": 15,
        "description": "防止边缘裁剪过紧（推荐 10-20）"
      },
      {
        "key": "mask_post_process",
        "title": "蒙版后处理",
        "type": "number",
        "min": 0,
        "max": 10,
        "value": 3,
        "description": "值越大边缘越干净（推荐 2-5）"
      },
      {
        "key": "edge_smoothing",
        "title": "边缘平滑度",
        "type": "number",
        "min": 0,
        "max": 100,
        "value": 80,
        "description": "控制边缘平滑程度（推荐 70-90）"
      }
    ]
  },
  {
    "category": "post_process_setting",
    "title": "后处理设置",
    "settings": [
      {
        "key": "post_process_mask",
        "title": "蒙版后处理",
        "type": "boolean",
        "value": false,
        "description": "减少噪点但可能损失细节"
      },
      {
        "key": "background_color",
        "title": "背景颜色",
        "type": "color",
        "value": "#ffffff",
        "description": "替换背景颜色（透明背景时无需设置）"
      }
    ]
  }
]